generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// --------------------------------------------------
// 1. ตารางพนักงาน (Users)
// --------------------------------------------------
model User {
  id          Int        @id @default(autoincrement())
  empId       String     @unique // รหัสพนักงาน (ห้ามซ้ำ)
  name        String
  department  String?
  role        String     @default("User") // ระดับสิทธิ์: Admin, Instructor, User
  
  // ความสัมพันธ์ (1 คน สร้างได้หลายคอร์ส / อัปโหลดได้หลายไฟล์)
  courses     Course[]   
  documents   Document[] 
  
  createdAt   DateTime   @default(now())
}

// --------------------------------------------------
// 2. ตารางคอร์สเรียน (Courses)
// --------------------------------------------------
model Course {
  id          Int        @id @default(autoincrement())
  title       String
  description String?    @db.Text
  category    String
  progress    Int        @default(0)
  
  // ผู้สร้างคอร์ส (เชื่อมกับตาราง User)
  creatorId   Int
  creator     User       @relation(fields: [creatorId], references: [id])
  
  // เอกสาร/วิดีโอ ที่อยู่ในคอร์สนี้
  documents   Document[] 
  
  createdAt   DateTime   @default(now())
}

// --------------------------------------------------
// 3. ตารางไฟล์และเอกสาร (Documents / KMS)
// --------------------------------------------------
model Document {
  id          Int        @id @default(autoincrement())
  title       String
  fileType    String     // เช่น PDF, MP4, DOCX
  filePath    String     // **สำคัญ:** เก็บแค่ "ที่อยู่ไฟล์" ไม่ใช่ตัวไฟล์
  
  // ใครเป็นคนอัปโหลด?
  uploaderId  Int
  uploader    User       @relation(fields: [uploaderId], references: [id])
  
  // ไฟล์นี้ผูกกับคอร์สไหน? (ถ้าเป็นเอกสาร KMS ทั่วไปจะไม่ผูกกับคอร์ส = null ได้)
  courseId    Int?
  course      Course?    @relation(fields: [courseId], references: [id])
  
  createdAt   DateTime   @default(now())
}